# Copy to .env and fill in real values. .env is gitignored.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=info@yourdomain.com.vn
# Gmail/Workspace app password (16 chars, 4 groups of 4)
IMAP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Thêm hộp thư khác bằng cách đánh số _2, _3, ... (host/port kế thừa nếu bỏ trống)
# IMAP_USER_2=other@domain.com
# IMAP_APP_PASSWORD_2=xxxx xxxx xxxx xxxx

# Comma-separated buyer tax codes (MST) to keep only "mua vào" invoices.
# Leave empty to disable buyer filtering.
MIYANO_MST=
